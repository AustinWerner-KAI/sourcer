# Copy to deploy/.env and fill in. Never commit the real file.

# Database
POSTGRES_PASSWORD=change-me

# Providers (added as milestones land)
PDL_API_KEY=
APOLLO_API_KEY=
ANTHROPIC_API_KEY=
# Recruitly (CRM/ATS): My Profile > API Keys. Use a key for a Sourcer user if you can.
RECRUITLY_API_KEY=
# Optional: most Recruitly calls per day (default 9000; the Professional plan allows 10,000)
RECRUITLY_DAILY_CAP=

# Microsoft 365 sign-in (Entra app registration "Sourcer")
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# The address people open Sourcer on; the Entra redirect URI is this + /api/auth/callback
PUBLIC_URL=http://localhost:8080
# Becomes admin on first sign-in
ADMIN_EMAIL=
